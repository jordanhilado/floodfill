/**
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "floodfill",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat"],
	// Custom entry: TanStack Start fetch handler + cron-driven Strava sync
	"main": "src/server.ts",
	"observability": { "enabled": true },
	"routes": [{ "pattern": "floodfill.world", "custom_domain": true }],
	// Served only from floodfill.world: no workers.dev URL, including preview URLs.
	"workers_dev": false,
	"preview_urls": false,
	"upload_source_maps": true,
	// CPU time per invocation. Matching tracks is CPU-bound, and a cron run or a rematch after a
	// city opens can match hundreds of activities: the 30 s default isn't enough as users grow.
	"limits": { "cpu_ms": 300000 },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "floodfill",
			"database_id": "453b8788-0478-4e9e-be77-b2212fd8ec95",
			// Local dev keeps using the database it was set up with before production existed.
			"preview_database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	// Sign-in codes. Locally this is simulated (see /cdn-cgi/local/explorer); in production the
	// sender domain must be onboarded: `wrangler email sending enable <domain>`.
	"send_email": [{ "name": "EMAIL" }],
	// Per-client request limits (src/server/limits.ts). namespace_id is any number unique to the account.
	"ratelimits": [
		// Sign-in code requests and checks, per IP: stops email floods and code guessing.
		{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		// Manual sync batches, per user.
		{ "name": "SYNC_LIMITER", "namespace_id": "1002", "simple": { "limit": 12, "period": 60 } },
		// Rematch batches, which anyone can start, per IP.
		{ "name": "REMATCH_LIMITER", "namespace_id": "1003", "simple": { "limit": 12, "period": 60 } }
	],
	// Strava's 15-minute rate windows reset at :00/:15/:30/:45, so sync just after each.
	"triggers": { "crons": ["1,16,31,46 * * * *"] },
	"vars": {
		// Standard-tier Strava limits. Overall: 400 / 15 min, 4,000 / day.
		// Read (all GET endpoints): 200 / 15 min, 2,000 / day.
		"STRAVA_LIMIT_15MIN": "400",
		"STRAVA_LIMIT_DAILY": "4000",
		"STRAVA_READ_LIMIT_15MIN": "200",
		"STRAVA_READ_LIMIT_DAILY": "2000",
		// Fraction of each limit this app may use, leaving headroom for other clients.
		"STRAVA_BUDGET_FRACTION": "0.9",
		// Athletes Strava lets connect to the app (strava.com/settings/api). Raise it when Strava does.
		"STRAVA_ATHLETE_LIMIT": "10",
		// Athletes connected outside production (local development, authorizations the callback
		// turned away), which Strava counts too: 5 connected on 2026-10-30, 2 of them in production.
		"STRAVA_ATHLETES_ELSEWHERE": "3",
		// Sender for sign-in codes, on the onboarded sending domain.
		"EMAIL_FROM": "login@floodfill.world"
	}
	// Secrets (put in .dev.vars locally, `wrangler secret put` in production):
	// STRAVA_CLIENT_ID, STRAVA_CLIENT_SECRET, AUTH_SECRET
	// Optional: STRAVA_WEBHOOK_TOKEN turns on Strava webhooks (routes/api/strava/webhook.ts).
}
