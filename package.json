{
	"name": "floodfill",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types",
		"generate-routes": "tsr generate",
		"streets": "node scripts/build-streets.ts",
		"totals": "node scripts/build-totals.ts",
		"db:setup": "wrangler d1 migrations apply floodfill --local && wrangler d1 execute floodfill --local --file=db/seed/sf-segments.sql"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-query": "^5.105.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "1.169.4",
		"@tanstack/react-virtual": "^3.14.23",
		"lucide-react": "^1.62.0",
		"maplibre-gl": "^6.16.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.26.0",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^5.0.5",
		"wrangler": "^4.154.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"sharp",
			"workerd"
		]
	}
}
